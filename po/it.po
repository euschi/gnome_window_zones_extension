msgstr "Zona unica"

#: extension/prefs/layoutEditor.js:351
msgid "Start From"
msgstr "Parti da"

#: extension/prefs/layoutEditor.js:352
msgid "Replaces the current zones"
msgstr "Sostituisce le zone attuali"

#: extension/prefs/layoutEditor.js:365
msgid ""
"Click a zone to split it into columns, Shift+click to split it into rows, "
"right-click (or Ctrl+click) to merge it with the zone next to it. Drag the "
"lines between zones to resize them."
msgstr ""
"Fai clic su una zona per dividerla in colonne, Maiusc+clic per dividerla in "
"righe, clic destro (o Ctrl+clic) per unirla alla zona accanto. Trascina le "
"linee tra le zone per ridimensionarle."

#: extension/prefs/layoutEditor.js:376
#, javascript-format
msgid "%d zone"
msgid_plural "%d zones"
msgstr[0] "%d zona"
msgstr[1] "%d zone"

#: extension/prefs/shortcutRow.js:22
msgid "Disabled"
msgstr "Disattivata"

#: extension/prefs/shortcutRow.js:29
msgid "Reset to Default"
msgstr "Ripristina predefinita"

#: extension/prefs/shortcutRow.js:50
msgid "Press the new shortcut, Backspace to disable it or Esc to cancel."
msgstr ""
"Premi la nuova scorciatoia, Backspace per disattivarla o Esc per annullare."

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:8
msgid "Maximize vertically on double click of the top or bottom border"
msgstr ""
"Massimizza in verticale con doppio clic sul bordo superiore o inferiore"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:12
msgid "Maximize horizontally on double click of the left or right border"
msgstr "Massimizza in orizzontale con doppio clic sul bordo sinistro o destro"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:18
msgid "Show zones while dragging a window with the modifier key held"
msgstr ""
"Mostra le zone trascinando una finestra con il tasto modificatore premuto"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:28
msgid "Modifier key that shows the zones while dragging"
msgstr "Tasto modificatore che mostra le zone durante il trascinamento"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:33
msgid "Space around windows placed in zones (px)"
msgstr "Spazio intorno alle finestre nelle zone (px)"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:37
msgid "Restore the original size when a snapped window is dragged away"
msgstr ""
"Ripristina la dimensione originale quando una finestra agganciata viene "
"trascinata via"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:41
msgid "Resize the windows next to a window while resizing it"
msgstr "Ridimensiona le finestre accanto a una finestra mentre la si ridimensiona"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:45
msgid "After snapping a window, offer the other windows for the free zones"
msgstr ""
"Dopo aver agganciato una finestra, proponi le altre finestre per le zone "
"libere"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:49
msgid "Snap to a quarter of the screen when a window is dragged to a corner"
msgstr ""
"Aggancia a un quarto dello schermo quando una finestra viene trascinata in "
"un angolo"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:54
msgid "Size of the corner areas that trigger quarter snapping (px)"
msgstr "Dimensione delle aree d'angolo che attivano l'aggancio ai quarti (px)"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:58
msgid "Add zones, layouts and window swapping to the window menu"
msgstr "Aggiunge zone, layout e scambio delle finestre al menu della finestra"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:62
msgid "Show the indicator in the top bar"
msgstr "Mostra l'indicatore nella barra superiore"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:68
msgid "Custom layouts (JSON)"
msgstr "Layout personalizzati (JSON)"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:72
msgid "Active layout of each monitor (JSON: connector → layout id)"
msgstr "Layout attivo di ogni monitor (JSON: connettore → id layout)"

#: extension/schemas/org.gnome.shell.extensions.winzones.gschema.xml:76
msgid "Layout used by monitors that have no layout chosen"
msgstr "Layout usato dai monitor senza un layout scelto"

